<% content_for "header" do %>
<meta name="description" content="<%= I18n.translate(locale, "An alternative front-end to YouTube") %>">
<title>
    <% if env.get("preferences").as(Preferences).default_home != "Trending" %>
        <%= I18n.translate(locale, "Trending") %> - DTUBE
    <% else %>
        DTUBE
    <% end %>
</title>
<% end %>

<%= rendered "components/feed_menu" %>

<div class="pure-g h-box">
    <div style="align-self:flex-end" class="pure-u-2-3">
        <% if plid %>
            <a href="/playlist?list=<%= plid %>">
                <%= I18n.translate(locale, "View as playlist") %>
            </a>
        <% end %>
    </div>
    <div class="pure-u-1-3">
        <div class="pure-g" style="text-align:right">
            <% {"Livestreams", "Gaming"}.each do |option| %>
                <div class="pure-u-1 pure-md-1-3">
                    <% if trending_type == option %>
                        <b><%= I18n.translate(locale, option) %></b>
                    <% else %>
                        <a href="/feed/trending?type=<%= option %>&region=<%= region %>">
                            <%= I18n.translate(locale, option) %>
                        </a>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>

<div class="h-box">
    <hr>
</div>

<div class="discovery-feed" data-discovery-feed data-api-endpoint="/api/v1/trending?type=<%= trending_type %>&region=<%= region %>" data-new-videos-label="<%= I18n.translate(locale, "discovery_new_videos_available") %>" data-refresh-label="<%= I18n.translate(locale, "discovery_refresh_button") %>" data-hide-watched-label="<%= I18n.translate(locale, "discovery_hide_watched") %>" data-familiar-label="<%= I18n.translate(locale, "discovery_familiar_channel") %>">
    <% section_title = I18n.translate(locale, "discovery_section_trending_now") %>
    <% section_items = trending %>
    <% section_scroll = false %>
    <% section_subtitle = nil %>
    <%= rendered "components/discovery_section" %>
</div>

<script src="/js/watched_indicator.js"></script>
<script src="/js/discovery.js?v=<%= ASSET_COMMIT %>" defer></script>
